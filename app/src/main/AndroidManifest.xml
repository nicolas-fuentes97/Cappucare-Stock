<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- EA3 · API REST: acceso a internet / red local y estado de la red. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- RNF-07 (opcional): notificación de stock mínimo. En Android 13+ se pide en tiempo de
         ejecución desde Alertas de reposición; en versiones anteriores se concede al instalar. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- RNF-06: cámara para escanear el código QR o de barras de un producto. Se pide en tiempo
         de ejecución al tocar el ícono de escanear. La app funciona igual en equipos sin cámara. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cappucare">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Cappucare">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla de cámara de la librería ZXing: que siga la orientación del teléfono. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />
    </application>

</manifest>
