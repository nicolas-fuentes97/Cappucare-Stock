# Plantilla de datos de firma del APK release. NO la edites con claves reales dentro del proyecto.
# Copia estos nombres a ~/.gradle/gradle.properties (archivo personal, fuera del repositorio) o
# defínelos como variables de entorno con los mismos nombres. app/build.gradle.kts los lee desde ahí.
#
# CAPPUCARE_STORE_FILE=C:/Users/tu-usuario/llaves/cappucare-release.jks
# CAPPUCARE_STORE_PASSWORD=<clave del almacén>
# CAPPUCARE_KEY_ALIAS=<alias que elegiste al crear el .jks>
# CAPPUCARE_KEY_PASSWORD=<clave de la llave>
